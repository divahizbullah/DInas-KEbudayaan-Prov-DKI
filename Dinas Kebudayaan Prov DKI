<footer>Dinas Kebudayaan Provinsi DKI Jakarta · Desember 2026</footer>

<script>
(function(){
"use strict";

var CATS=[
  {id:"betawi",label:"UMKM Betawi",desc:"Usaha dengan produk atau karya khas budaya Betawi."},
  {id:"nusantara",label:"UMKM Nusantara",desc:"Usaha dengan produk khas daerah lain di Indonesia."},
  {id:"nonnusantara",label:"UMKM Non Nusantara",desc:"Usaha dengan produk di luar kekhasan Nusantara."}
];
var PKGS=[
  {id:"full",label:"12–20 Desember",desc:"Kota Tua (12–15) lalu Pasar Hexagon (16–20). Total 9 hari."},
  {id:"kt",label:"12–15 Desember",desc:"Kawasan UPK Kota Tua saja. 4 hari."},
  {id:"ph",label:"16–20 Desember",desc:"Pasar Hexagon saja. 5 hari."}
];
var PRODS=["Makanan","Minuman","Souvenir","Pakaian","Jasa","Lainnya"];

var S={cat:"",pkg:"",prods:[],other:"",nama:"",kontak:"",hp:"",email:"",nib:"",photos:[]};
var db=null,uid=null,isAdmin=false,fees=null,regs=[],lastRecord=null,saving=false;

function $(id){return document.getElementById(id)}
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function catLabel(id){var c=CATS.filter(function(x){return x.id===id})[0];return c?c.label:"-"}
function pkgLabel(id){var c=PKGS.filter(function(x){return x.id===id})[0];return c?c.label:"-"}
function pkgFull(id){var c=PKGS.filter(function(x){return x.id===id})[0];return c?(c.label+" · "+(id==="full"?"Kota Tua lalu Pasar Hexagon":id==="kt"?"Kawasan UPK Kota Tua":"Pasar Hexagon")):"-"}
function rp(n){return "Rp "+Number(n).toLocaleString("id-ID")}
function emptyFees(){var f={};CATS.forEach(function(c){f[c.id]={};PKGS.forEach(function(p){f[c.id][p.id]=null})});return f}
fees=emptyFees();
function feeFor(cat,pkg){if(!cat||!pkg)return undefined;var v=fees[cat]&&fees[cat][pkg];return (typeof v==="number")?v:null}
function prodList(){return S.prods.map(function(p){return p==="Lainnya"?("Lainnya: "+(S.other.trim()||"…")):p})}
function snapData(d){return (d&&typeof d.data==="function")?d.data():(d&&d.data)||{}}

/* ---- build option cards ---- */
function buildRadios(el,name,items){
  el.innerHTML=items.map(function(it){
    return '<label class="opt"><input type="radio" name="'+name+'" value="'+it.id+'"><span class="card"><span class="tick" aria-hidden="true">✓</span><strong>'+esc(it.label)+'</strong><small>'+esc(it.desc)+'</small></span></label>';
  }).join("");
}
buildRadios($("catOpts"),"cat",CATS);
buildRadios($("pkgOpts"),"pkg",PKGS);
$("prodOpts").innerHTML=PRODS.map(function(p){
  return '<label class="opt tag"><input type="checkbox" name="prod" value="'+p+'"><span class="card"><span class="tick" aria-hidden="true">✓</span><strong>'+p+'</strong></span></label>';
}).join("");

/* ---- events ---- */
document.addEventListener("change",function(e){
  var t=e.target;
  if(t.name==="cat"){S.cat=t.value;hideErr("e-cat")}
  else if(t.name==="pkg"){S.pkg=t.value;hideErr("e-pkg")}
  else if(t.name==="prod"){
    S.prods=[].slice.call(document.querySelectorAll('input[name=prod]:checked')).map(function(i){return i.value});
    var hasOther=S.prods.indexOf("Lainnya")>-1;
    $("otherWrap").hidden=!hasOther;
    if(hasOther)$("other").focus();
    if(S.prods.length)hideErr("e-prod");
  } else return;
  update();
});
["other","nama","kontak","hp","email","nib"].forEach(function(id){
  $(id).addEventListener("input",function(){S[id]=this.value;this.classList.remove("invalid");var er=$("e-"+id);if(er)er.textContent="";update()});
});
function hideErr(id){$(id).classList.remove("show")}
function showErr(id){$(id).classList.add("show")}

/* ---- summary ---- */
function setDD(id,txt,empty){var el=$(id);el.textContent=txt;el.className=empty?"empty":""}
function update(){
  setDD("s-nib",S.nib.trim()||"Tidak diisi",!S.nib.trim());
  setDD("s-foto",S.photos.length?(S.photos.length+" foto"):"Tidak ada",!S.photos.length);
  setDD("s-cat",S.cat?catLabel(S.cat):"Belum dipilih",!S.cat);
  setDD("s-prod",S.prods.length?prodList().join(", "):"Belum dipilih",!S.prods.length);
  setDD("s-pkg",S.pkg?pkgFull(S.pkg):"Belum dipilih",!S.pkg);
  setDD("s-nama",S.nama.trim()||"Belum diisi",!S.nama.trim());
  setDD("s-kontak",S.kontak.trim()?(S.kontak.trim()+(S.hp.trim()?" · "+S.hp.trim():"")):"Belum diisi",!S.kontak.trim());
  var f=feeFor(S.cat,S.pkg);
  if(f===undefined){$("s-fee").textContent="—";$("s-feeNote").textContent="Pilih kategori dan lama hari untuk melihat biaya."}
  else if(f===null){$("s-fee").textContent="Menyusul";$("s-feeNote").textContent="Biaya untuk pilihan ini belum ditetapkan. Panitia akan menginformasikannya setelah Anda mendaftar."}
  else if(f===0){$("s-fee").textContent="Gratis";$("s-feeNote").textContent="Tidak ada biaya untuk pilihan ini."}
  else{$("s-fee").textContent=rp(f);$("s-feeNote").textContent="Tata cara pembayaran akan disampaikan panitia."}
}

/* ---- validation + submit ---- */
function validate(){
  var ok=true,first=null;
  function bad(secId,errId,msg){ok=false;if(msg)$(errId).textContent=msg;else showErr(errId);if(!first)first=$(secId)}
  if(!S.cat)bad("fs-cat","e-cat");
  if(!S.prods.length)bad("fs-prod","e-prod");
  else if(S.prods.indexOf("Lainnya")>-1&&!S.other.trim()){ok=false;$("other").classList.add("invalid");if(!first)first=$("other")}
  if(!S.pkg)bad("fs-pkg","e-pkg");
  if(!S.nama.trim()){bad("fs-data","e-nama","Isi nama UMKM.");$("nama").classList.add("invalid")}
  if(!S.kontak.trim()){bad("fs-data","e-kontak","Isi nama kontak person.");$("kontak").classList.add("invalid")}
  var digits=S.hp.replace(/[\s\-+()]/g,"");
  if(!/^\d{9,14}$/.test(digits)){bad("fs-data","e-hp","Isi nomor WhatsApp yang valid, 9–14 angka.");$("hp").classList.add("invalid")}
  if(S.email.trim()&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(S.email.trim())){bad("fs-data","e-email","Format email belum benar.");$("email").classList.add("invalid")}
  var nd=S.nib.replace(/\D/g,"");
  if(S.nib.trim()&&nd.length!==13){bad("fs-data","e-nib","NIB terdiri dari 13 angka. Kosongkan jika belum punya.");$("nib").classList.add("invalid")}
  if(!ok&&first)first.scrollIntoView({behavior:"smooth",block:"center"});
  return ok;
}
function newCode(){var a="ABCDEFGHJKLMNPQRSTUVWXYZ23456789",s="";for(var i=0;i<5;i++)s+=a[Math.floor(Math.random()*a.length)];return "UMKM-"+s}

function summaryText(r){
  var f=r.biaya;
  return ["PENDAFTARAN UMKM · Dinas Kebudayaan Provinsi DKI Jakarta","Kode: "+r.kode,"Kategori: "+catLabel(r.kategori),"Yang dijual: "+r.produk.join(", "),"Lama hari: "+pkgFull(r.paket),"Nama UMKM: "+r.namaUmkm,"Kontak person: "+r.kontak+" ("+r.hp+")","Email: "+(r.email||"-"),"NIB: "+(r.nib||"-"),"Foto produk: "+(r.fotoCount||0)+" file","Biaya: "+(typeof f==="number"?rp(f):"Menyusul")].join("\n");
}

$("submitBtn").addEventListener("click",async function(){
  if(saving||!validate())return;
  saving=true;var btn=this;btn.disabled=true;btn.textContent="Mengirim…";$("submitNote").textContent="";
  var f=feeFor(S.cat,S.pkg);
  var rec={kode:newCode(),kategori:S.cat,paket:S.pkg,produk:prodList(),namaUmkm:S.nama.trim(),kontak:S.kontak.trim(),hp:S.hp.trim(),email:S.email.trim(),nib:S.nib.replace(/\D/g,""),uid:uid||"",fotoCount:S.photos.length,biaya:(typeof f==="number")?f:null,createdAt:Date.now(),status:"baru"};
  var stored=false,photoFail=false;
  if(db){
    try{
      if(!uid)throw new Error("no-user");
      var ref=db.doc("registrations/"+uid),cur=await ref.get(),ent={};ent[rec.kode]=rec;
      if(cur&&cur.exists)await ref.update({entries:ent});else await ref.set({entries:ent});
      stored=true;
      if(S.photos.length){
        try{await db.doc("registrations/"+uid+"/photos/"+rec.kode).set({kode:rec.kode,images:S.photos.slice()})}
        catch(pe){rec.fotoCount=0;try{var e2={};e2[rec.kode]={fotoCount:0};await ref.update({entries:e2})}catch(_){}photoFail=true}
      }
    }catch(e){stored=false}
  }
  saving=false;btn.disabled=false;btn.textContent="Kirim pendaftaran";
  if(!stored){
    $("submitNote").textContent="Pengiriman online belum tersedia di tampilan ini. Anda tetap bisa melihat dan menyalin data pendaftaran untuk dikirim ke panitia.";
  }
  lastRecord=rec;showDone(rec,stored);if(photoFail)$("d-note").textContent="Pendaftaran tersimpan, tetapi foto produk gagal terunggah. Kirim foto langsung ke panitia lewat WhatsApp.";
});

function showDone(r,stored){
  $("d-code").textContent=r.kode;
  var rows=[["Kategori",catLabel(r.kategori)],["Yang dijual",r.produk.join(", ")],["Lama hari",pkgFull(r.paket)],["Nama UMKM",r.namaUmkm],["Kontak person",r.kontak+" · "+r.hp],["NIB",r.nib||"Tidak diisi"],["Foto produk",r.fotoCount?r.fotoCount+" foto":"Tidak ada"],["Biaya",typeof r.biaya==="number"?rp(r.biaya):"Menyusul, akan diinformasikan panitia"]];
  $("d-list").innerHTML=rows.map(function(x){return "<dt>"+esc(x[0])+"</dt><dd>"+esc(x[1])+"</dd>"}).join("");
  $("d-note").textContent=stored?"":"Data ini belum tersimpan di sistem panitia. Salin lalu kirim ke panitia agar pendaftaran tercatat.";
  $("formView").hidden=true;$("doneView").hidden=false;window.scrollTo({top:0,behavior:"smooth"});
}
$("copyBtn").addEventListener("click",async function(){
  var t=summaryText(lastRecord),b=this;
  try{await navigator.clipboard.writeText(t);b.textContent="Tersalin"}catch(e){
    var ta=document.createElement("textarea");ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand("copy");b.textContent="Tersalin"}catch(_){b.textContent="Gagal menyalin"}document.body.removeChild(ta)}
  setTimeout(function(){b.textContent="Salin data pendaftaran"},2000);
});
$("againBtn").addEventListener("click",function(){
  S={cat:"",pkg:"",prods:[],other:"",nama:"",kontak:"",hp:"",email:"",nib:"",photos:[]};renderPhotos();
  document.querySelectorAll("#form input").forEach(function(i){if(i.type==="radio"||i.type==="checkbox")i.checked=false;else i.value=""});
  $("otherWrap").hidden=true;$("submitNote").textContent="";
  $("doneView").hidden=true;$("formView").hidden=false;update();window.scrollTo({top:0,behavior:"smooth"});
});

/* ---- admin ---- */
function renderFeeTable(){
  var h='<thead><tr><th>Kategori</th>'+PKGS.map(function(p){return '<th>'+esc(p.label)+'</th>'}).join("")+'</tr></thead><tbody>';
  CATS.forEach(function(c){
    h+='<tr><td><b>'+esc(c.label)+'</b></td>'+PKGS.map(function(p){
      var v=fees[c.id][p.id];
      return '<td><input type="text" inputmode="numeric" data-c="'+c.id+'" data-p="'+p.id+'" value="'+(typeof v==="number"?v:"")+'" placeholder="Menyusul" aria-label="Biaya '+esc(c.label)+' '+esc(p.label)+' dalam Rupiah"></td>';
    }).join("")+'</tr>';
  });
  $("feeTable").innerHTML=h+'</tbody>';
}
$("saveFees").addEventListener("click",async function(){
  var nf=emptyFees();
  document.querySelectorAll("#feeTable input").forEach(function(i){
    var raw=i.value.replace(/\D/g,"");nf[i.dataset.c][i.dataset.p]=raw===""?null:parseInt(raw,10);
  });
  var m=$("feeMsg");
  try{await db.doc("config/fees").set({fees:nf,updatedAt:Date.now()});fees=nf;m.textContent="Biaya tersimpan.";update()}
  catch(e){m.textContent="Biaya belum tersimpan. Coba lagi."}
  setTimeout(function(){m.textContent=""},3000);
});
function renderRegs(){
  var n=regs.length,c={betawi:0,nusantara:0,nonnusantara:0};
  regs.forEach(function(r){if(c[r.kategori]!=null)c[r.kategori]++});
  $("stats").innerHTML='<div class="stat"><b>'+n+'</b><span>Total pendaftar</span></div>'+CATS.map(function(x){return '<div class="stat"><b>'+c[x.id]+'</b><span>'+esc(x.label)+'</span></div>'}).join("");
  if(!n){$("regTable").innerHTML='<div class="empty-state">Belum ada pendaftar.</div>';return}
  var h='<table><thead><tr><th>Kode</th><th>Waktu</th><th>UMKM</th><th>Kategori</th><th>Dijual</th><th>Lama hari</th><th>Kontak</th><th>NIB</th><th>Foto</th><th>Biaya</th></tr></thead><tbody>';
  regs.forEach(function(r){
    var d=new Date(r.createdAt||0).toLocaleString("id-ID",{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"});
    h+='<tr><td>'+esc(r.kode)+'</td><td>'+esc(d)+'</td><td><button class="linkbtn" type="button" data-detail="'+esc(r.kode)+'">'+esc(r.namaUmkm)+'</button>'+((r.createdAt||0)>lastSeen?' <span class="pill">Baru</span>':'')+'</td><td>'+esc(catLabel(r.kategori))+'</td><td>'+esc((r.produk||[]).join(", "))+'</td><td>'+esc(pkgLabel(r.paket))+'</td><td>'+esc(r.kontak)+'<br>'+esc(r.hp)+(r.email?'<br>'+esc(r.email):'')+'</td><td>'+esc(r.nib||"-")+'</td><td>'+(r.fotoCount&&r.uid?'<button class="btn small ghost" type="button" data-photo="'+esc(r.uid)+'|'+esc(r.kode)+'">Lihat ('+r.fotoCount+')</button>':'-')+'</td><td>'+(typeof r.biaya==="number"?esc(rp(r.biaya)):'Menyusul')+'</td></tr>';
  });
  $("regTable").innerHTML=h+'</tbody></table>';
}
$("exportBtn").addEventListener("click",async function(){
  if(!regs.length)return;
  var q=function(v){return '"'+String(v==null?"":v).replace(/"/g,'""')+'"'};
  var head=["Kode","Waktu","Nama UMKM","Kategori","Yang dijual","Lama hari","Kontak person","WhatsApp","Email","NIB","Jumlah foto","Biaya"];
  var lines=[head.map(q).join(",")].concat(regs.map(function(r){
    return [r.kode,new Date(r.createdAt||0).toISOString(),r.namaUmkm,catLabel(r.kategori),(r.produk||[]).join("; "),pkgLabel(r.paket),r.kontak,r.hp,r.email,r.nib||"",r.fotoCount||0,typeof r.biaya==="number"?r.biaya:"Menyusul"].map(q).join(",");
  }));
  try{var dl=await claude.use("downloads");if(dl)await dl.save({filename:"pendaftar-umkm.csv",data:"\ufeff"+lines.join("\r\n")})}catch(e){}
});
$("adminBtn").addEventListener("click",function(){
  var on=$("admin").classList.toggle("on");
  this.textContent=on?"Tutup panel panitia":"Buka panel panitia";
  if(on)$("admin").scrollIntoView({behavior:"smooth",block:"start"});
});

/* ---- photos ---- */
var MAXP=2,MAXCH=90000;
function loadImg(file){return new Promise(function(res,rej){var u=URL.createObjectURL(file),im=new Image();im.onload=function(){URL.revokeObjectURL(u);res(im)};im.onerror=function(){URL.revokeObjectURL(u);rej(new Error("img"))};im.src=u})}
async function shrink(file){
  var im=await loadImg(file),sc=Math.min(1,720/Math.max(im.width,im.height)),w=Math.max(1,Math.round(im.width*sc)),h=Math.max(1,Math.round(im.height*sc)),q=.75,d="",c=document.createElement("canvas"),n=0;
  do{
    c.width=w;c.height=h;var x=c.getContext("2d");x.fillStyle="#fff";x.fillRect(0,0,w,h);x.drawImage(im,0,0,w,h);d=c.toDataURL("image/jpeg",q);n++;
    if(d.length>MAXCH){if(q>.45)q-=.1;else{w=Math.round(w*.8);h=Math.round(h*.8)}}
  }while(d.length>MAXCH&&n<10);
  if(d.length>MAXCH)throw new Error("big");
  return d;
}
function renderPhotos(){
  $("thumbs").innerHTML=S.photos.map(function(d,i){return '<div class="th"><img src="'+d+'" alt="Foto produk '+(i+1)+'"><button type="button" data-rm="'+i+'" aria-label="Hapus foto '+(i+1)+'">×</button></div>'}).join("");
  $("photoCount").textContent=S.photos.length?(S.photos.length+" dari "+MAXP+" foto"):"Belum ada foto";
  $("pickLbl").classList.toggle("off",S.photos.length>=MAXP);
  $("photoIn").disabled=S.photos.length>=MAXP;
  update();
}
$("photoIn").addEventListener("change",async function(){
  var files=[].slice.call(this.files||[]),er=$("e-photo");er.textContent="";
  for(var i=0;i<files.length&&S.photos.length<MAXP;i++){
    var f=files[i];
    if(!/^image\//.test(f.type)){er.textContent="Hanya file gambar yang bisa diunggah.";continue}
    if(f.size>15*1024*1024){er.textContent="Satu foto maksimal 15 MB.";continue}
    try{S.photos.push(await shrink(f))}catch(e){er.textContent="Foto tidak bisa diproses. Coba foto lain."}
  }
  this.value="";renderPhotos();
});
$("thumbs").addEventListener("click",function(e){var b=e.target.closest("[data-rm]");if(b){S.photos.splice(+b.dataset.rm,1);renderPhotos()}});
document.addEventListener("click",async function(e){
  var b=e.target.closest("[data-photo]");if(!b||!db)return;
  var parts=b.dataset.photo.split("|"),dlg=$("photoDlg"),body=$("dlgBody");
  body.innerHTML='<p>Memuat foto…</p>';if(!dlg.open)dlg.showModal();
  try{
    var snap=await db.doc("registrations/"+parts[0]+"/photos/"+parts[1]).get(),d=snapData(snap),im=d.images||[];
    body.innerHTML=im.length?im.map(function(u,i){return '<img src="'+esc(u)+'" alt="Foto produk '+(i+1)+' dari '+esc(parts[1])+'">'}).join(""):'<p>Foto tidak ditemukan.</p>';
  }catch(err){body.innerHTML='<p>Foto tidak bisa dimuat.</p>'}
});
$("dlgClose").addEventListener("click",function(){$("photoDlg").close()});

/* ---- login panitia + notifikasi ---- */
var adminActive=false,unsub=null,lastSeen=0,firstSnap=true,toastT=null;
function fmtTime(t){return new Date(t||0).toLocaleString("id-ID",{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"})}
function toast(msg){var t=$("toast");t.textContent=msg;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(function(){t.hidden=true},4500)}
function setAdminUI(on){
  adminActive=on;$("loginBtn").hidden=on;$("adminTools").hidden=!on;
  if(!on){$("admin").classList.remove("on");$("notif").hidden=true;$("bellBtn").setAttribute("aria-expanded","false");$("adminBtn").textContent="Buka panel panitia"}
}
async function loadSeen(){
  if(!db||!uid)return;
  try{var sn=await db.doc("data/users/"+uid+"/state").get();lastSeen=+(snapData(sn).lastSeen)||0}catch(e){}
}
async function saveSeen(t){
  lastSeen=t;renderBell();renderRegs();
  if(!db||!uid)return;
  try{await db.doc("data/users/"+uid+"/state").set({lastSeen:t})}catch(e){}
}
function unreadList(){return regs.filter(function(r){return (r.createdAt||0)>lastSeen})}
function renderBell(){
  var u=unreadList().length,b=$("badge");
  b.hidden=!u;b.textContent=u>9?"9+":String(u);
  $("bellBtn").setAttribute("aria-label",u?("Notifikasi, "+u+" pendaftar baru"):"Notifikasi, tidak ada pendaftar baru");
  var L=$("notifList");
  if(!regs.length){L.innerHTML='<div class="empty-state">Belum ada pendaftar.</div>';return}
  L.innerHTML=regs.slice(0,8).map(function(r){
    var nw=(r.createdAt||0)>lastSeen;
    return '<button class="nitem" type="button" data-detail="'+esc(r.kode)+'"><span class="t">'+(nw?'<span class="udot" aria-label="Baru"></span>':'')+esc(r.namaUmkm)+'</span><span class="m">'+esc(catLabel(r.kategori))+' · '+esc(pkgLabel(r.paket))+' · '+esc(fmtTime(r.createdAt))+'</span></button>';
  }).join("");
}
function startAdmin(){
  setAdminUI(true);renderFeeTable();firstSnap=true;
  loadSeen().then(function(){
    if(!adminActive)return;
    try{
      unsub=db.collection("registrations").onSnapshot(function(snap){
        var all=[];
        snap.docs.forEach(function(d){var e=snapData(d).entries||{};Object.keys(e).forEach(function(k){all.push(e[k])})});
        all.sort(function(a,b){return (b.createdAt||0)-(a.createdAt||0)});
        var prev={};regs.forEach(function(r){prev[r.kode]=1});
        var fresh=all.filter(function(r){return !prev[r.kode]});
        regs=all;
        if(!firstSnap&&fresh.length)toast("Pendaftar baru: "+fresh[0].namaUmkm+(fresh.length>1?" dan "+(fresh.length-1)+" lainnya":""));
        firstSnap=false;renderRegs();renderBell();
      },function(){toast("Data pendaftar tidak bisa dimuat.")});
    }catch(e){}
  });
}
function stopAdmin(){if(unsub){unsub();unsub=null}regs=[];firstSnap=true;renderRegs();setAdminUI(false)}

$("loginBtn").addEventListener("click",function(){$("loginMsg").textContent="";$("loginDlg").showModal()});
$("loginCancel").addEventListener("click",function(){$("loginDlg").close()});
$("loginGo").addEventListener("click",async function(){
  var m=$("loginMsg"),btn=this;
  if(!(window.claude&&claude.use)){m.textContent="Login panitia hanya tersedia di versi yang dipublikasikan lewat Claude. File ini tidak terhubung ke data pendaftar.";return}
  btn.disabled=true;m.textContent="Memeriksa akun…";
  try{
    var u=await claude.use("user");
    if(!u){m.textContent="Anda belum masuk ke akun Claude. Masuk dulu, lalu coba lagi."}
    else if(!(await u.canEdit())){m.textContent="Akun ini belum terdaftar sebagai panitia. Minta pemilik halaman menambahkannya sebagai Editor."}
    else{
      isAdmin=true;try{uid=await u.id()}catch(_){}
      if(!db){try{db=await claude.use("db")}catch(_){db=null}}
      if(!db){m.textContent="Penyimpanan data tidak tersedia di tampilan ini."}
      else{$("loginDlg").close();startAdmin()}
    }
  }catch(e){m.textContent="Gagal memeriksa akun. Coba lagi."}
  btn.disabled=false;
});
$("logoutBtn").addEventListener("click",stopAdmin);
$("bellBtn").addEventListener("click",function(e){
  e.stopPropagation();var n=$("notif");n.hidden=!n.hidden;this.setAttribute("aria-expanded",String(!n.hidden));
});
document.addEventListener("click",function(e){
  if(!$("notif").hidden&&!e.target.closest(".bellwrap")){$("notif").hidden=true;$("bellBtn").setAttribute("aria-expanded","false")}
});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!$("notif").hidden){$("notif").hidden=true;$("bellBtn").setAttribute("aria-expanded","false");$("bellBtn").focus()}});
$("markRead").addEventListener("click",function(){if(regs.length)saveSeen(Math.max.apply(null,regs.map(function(r){return r.createdAt||0})))});

/* detail pendaftar */
function waLink(hp){var d=String(hp||"").replace(/\D/g,"");if(d.indexOf("0")===0)d="62"+d.slice(1);return d?("https://wa.me/"+d):""}
async function showDetail(kode){
  var r=regs.filter(function(x){return x.kode===kode})[0];if(!r)return;
  $("notif").hidden=true;$("bellBtn").setAttribute("aria-expanded","false");
  var wa=waLink(r.hp);
  var rows=[["Kode",r.kode],["Waktu daftar",fmtTime(r.createdAt)],["Kategori",catLabel(r.kategori)],["Yang dijual",(r.produk||[]).join(", ")],["Lama hari",pkgFull(r.paket)],["Kontak person",r.kontak],["NIB",r.nib||"Tidak diisi"],["Email",r.email||"Tidak diisi"],["Biaya",typeof r.biaya==="number"?rp(r.biaya):"Menyusul"]];
  var h='<h2>'+esc(r.namaUmkm)+'</h2><dl>'+rows.map(function(x){return '<dt>'+esc(x[0])+'</dt><dd>'+esc(x[1])+'</dd>'}).join("")+'<dt>WhatsApp</dt><dd>'+esc(r.hp)+(wa?' · <a href="'+esc(wa)+'" target="_blank" rel="noopener">Buka chat</a>':'')+'</dd></dl>';
  h+=(r.fotoCount&&r.uid)?'<div class="dphotos" id="dphotos"><span class="note">Memuat foto…</span></div>':'<p class="note">Tidak ada foto produk.</p>';
  $("detailBody").innerHTML=h;
  var dlg=$("detailDlg");if(!dlg.open)dlg.showModal();
  if(r.fotoCount&&r.uid&&db){
    try{
      var sn=await db.doc("registrations/"+r.uid+"/photos/"+r.kode).get(),im=snapData(sn).images||[],box=$("dphotos");
      if(box)box.innerHTML=im.length?im.map(function(u,i){return '<img src="'+esc(u)+'" alt="Foto produk '+(i+1)+' milik '+esc(r.namaUmkm)+'">'}).join(""):'<span class="note">Foto tidak ditemukan.</span>';
    }catch(e){var b2=$("dphotos");if(b2)b2.innerHTML='<span class="note">Foto tidak bisa dimuat.</span>'}
  }
}
document.addEventListener("click",function(e){var b=e.target.closest("[data-detail]");if(b)showDetail(b.dataset.detail)});
$("detailClose").addEventListener("click",function(){$("detailDlg").close()});

/* ---- init capabilities ---- */
async function init(){
  update();
  if(!(window.claude&&claude.use)){showBanner("Formulir ini belum terhubung ke penyimpanan data panitia. Setelah mengisi, salin data pendaftaran lalu kirim ke panitia.");return}
  try{var u=await claude.use("user");if(u){isAdmin=!!(await u.canEdit());try{uid=await u.id()}catch(_){}}}catch(e){}
  try{db=await claude.use("db")}catch(e){db=null}
  if(!db){showBanner("Anda belum masuk. Formulir tetap bisa diisi, dan data dapat disalin untuk dikirim ke panitia.");return}
  try{
    db.doc("config/fees").onSnapshot(function(s){
      var d=snapData(s);var nf=emptyFees();
      if(d.fees)CATS.forEach(function(c){PKGS.forEach(function(p){var v=d.fees[c.id]&&d.fees[c.id][p.id];if(typeof v==="number")nf[c.id][p.id]=v})});
      fees=nf;update();
      if(isAdmin&&!document.activeElement.closest("#feeTable"))renderFeeTable();
    },function(){});
  }catch(e){}
}
function showBanner(t){var b=$("banner");b.textContent=t;b.hidden=false}
init();
})();
</script>
