<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pendaftaran UMKM · Dinas Kebudayaan Provinsi DKI Jakarta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#F5F8F4; --surface:#FFFFFF; --ink:#182623; --muted:#5B6B67; --line:#D5DED9;
  --green:#0E5A4E; --green-soft:#E1EFE9; --red:#C32F27; --red-soft:#FBE7E4; --gold:#F0B429; --gold-soft:#FFF4D6;
  --focus:#1565C0;
  --display:'Bricolage Grotesque','Trebuchet MS',system-ui,sans-serif;
  --body:'Instrument Sans','Segoe UI',system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F1A18; --surface:#16231F; --ink:#EAF1EE; --muted:#9FB1AB; --line:#2A3B36;
    --green:#5CC4AE; --green-soft:#17352E; --red:#FF7B70; --red-soft:#3A1E1B; --gold:#F5C453; --gold-soft:#3A3012;
    --focus:#7DB7FF;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1A18; --surface:#16231F; --ink:#EAF1EE; --muted:#9FB1AB; --line:#2A3B36;
  --green:#5CC4AE; --green-soft:#17352E; --red:#FF7B70; --red-soft:#3A1E1B; --gold:#F5C453; --gold-soft:#3A3012;
  --focus:#7DB7FF;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.55;-webkit-text-size-adjust:100%}
button,input,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* Tumpal band */
.tumpal{height:22px;background-color:var(--red);
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='44' height='22' viewBox='0 0 44 22'><polygon points='0,22 22,0 44,22' fill='%23F0B429'/><polygon points='9,22 22,8 35,22' fill='%230E5A4E'/></svg>");
  background-size:44px 22px;background-repeat:repeat-x;background-position:bottom}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

/* Hero */
header.hero{background:var(--green);color:#fff;padding:36px 0 30px}
:root[data-theme="dark"] header.hero, :root:not([data-theme="light"]) header.hero{}
.hero .org{font-size:.95rem;opacity:.9;margin:0 0 18px;max-width:46ch}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(2.2rem,6.2vw,4.2rem);line-height:1.02;margin:0 0 26px;letter-spacing:-.02em;max-width:14ch}
.route{display:grid;grid-template-columns:1fr;gap:0;max-width:640px}
.leg{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;position:relative;padding-bottom:18px}
.leg:last-child{padding-bottom:0}
.leg::before{content:"";position:absolute;left:11px;top:26px;bottom:-2px;width:2px;background:rgba(255,255,255,.4)}
.leg:last-child::before{display:none}
.dot{width:24px;height:24px;border-radius:50%;background:var(--gold);border:4px solid var(--green);box-shadow:0 0 0 2px var(--gold);margin-top:3px}
.leg b{font-family:var(--display);font-size:1.35rem;font-weight:700;display:block;line-height:1.2}
.leg span{opacity:.92}
.tools{display:flex;gap:10px;justify-content:flex-end;padding:10px 0 0}
.chipbtn{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:999px;padding:6px 14px;cursor:pointer;font-size:.88rem}
.chipbtn:hover{background:rgba(255,255,255,.25)}
.chipbtn[hidden]{display:none}

/* Layout */
main{padding:32px 0 80px}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:32px;align-items:start}
@media (max-width:900px){.grid{grid-template-columns:1fr}}
fieldset{border:0;margin:0 0 34px;padding:0;min-width:0}
legend{padding:0;margin:0 0 4px;font-family:var(--display);font-weight:700;font-size:1.4rem;display:flex;gap:12px;align-items:baseline}
legend .n{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--green);color:var(--bg);font-size:.95rem;flex:none;transform:translateY(-2px)}
:root[data-theme="dark"] legend .n{color:#0F1A18}
.hint{color:var(--muted);margin:0 0 14px;font-size:.95rem}
.opts{display:grid;gap:12px}
.opts.three{grid-template-columns:repeat(3,1fr)}
@media (max-width:760px){.opts.three{grid-template-columns:1fr}}
.opt{position:relative;display:block;cursor:pointer}
.opt input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.card{display:block;height:100%;background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:16px 16px 14px;transition:border-color .15s,background .15s}
.card strong{display:block;font-family:var(--display);font-size:1.15rem;line-height:1.25;margin-bottom:4px}
.card small{display:block;color:var(--muted);font-size:.9rem;line-height:1.4}
.opt:hover .card{border-color:var(--green)}
.opt input:checked + .card{border-color:var(--green);background:var(--green-soft);box-shadow:inset 0 0 0 1px var(--green)}
.opt input:focus-visible + .card{outline:3px solid var(--focus);outline-offset:2px}
.card .tick{float:right;width:22px;height:22px;border-radius:50%;border:2px solid var(--line);margin-left:8px;display:grid;place-items:center;font-size:.8rem;color:transparent}
.opt input:checked + .card .tick{background:var(--green);border-color:var(--green);color:var(--surface)}
.tags{display:flex;flex-wrap:wrap;gap:10px}
.tag .card{padding:10px 18px;border-radius:999px;display:flex;gap:8px;align-items:center;height:auto}
.tag .card strong{margin:0;font-family:var(--body);font-weight:600;font-size:1rem}
.tag .card .tick{float:none;width:18px;height:18px;margin:0;border-radius:5px}
.other{margin-top:14px}
.field{display:block;margin-bottom:16px}
.field > span{display:block;font-weight:600;margin-bottom:6px}
.field > span i{font-style:normal;font-weight:400;color:var(--muted)}
input[type=text],input[type=tel],input[type=email]{width:100%;background:var(--surface);border:2px solid var(--line);border-radius:10px;padding:12px 14px;min-height:48px}
input[type=text]:hover,input[type=tel]:hover,input[type=email]:hover{border-color:var(--green)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
@media (max-width:640px){.two{grid-template-columns:1fr}}
.err{color:var(--red);font-size:.9rem;margin:6px 0 0;min-height:0}
.invalid{border-color:var(--red)!important}
.section-err{background:var(--red-soft);color:var(--red);border-radius:8px;padding:8px 12px;margin-top:10px;font-weight:500;display:none}
.section-err.show{display:block}

/* Summary */
aside .sum{position:sticky;top:calc(16px + env(safe-area-inset-top,0px));background:var(--surface);border:2px solid var(--line);border-radius:16px;overflow:hidden}
@media (max-width:900px){aside .sum{position:static}}
.sum h2{font-family:var(--display);font-size:1.15rem;margin:0;padding:16px 18px 12px}
.sum dl{margin:0;padding:0 18px 4px}
.sum dt{font-size:.85rem;color:var(--muted);margin-top:10px}
.sum dd{margin:2px 0 0;font-weight:600}
.sum dd.empty{color:var(--muted);font-weight:400}
.fee{margin-top:14px;padding:14px 18px;background:var(--gold-soft);border-top:2px solid var(--line)}
.fee .lbl{font-size:.85rem;color:var(--muted)}
.fee .amt{font-family:var(--display);font-weight:800;font-size:1.7rem;line-height:1.2}
.fee p{margin:6px 0 0;font-size:.85rem;color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:14px 22px;min-height:50px;font-weight:600;font-size:1.05rem;cursor:pointer;background:var(--green);color:#fff;width:100%}
:root[data-theme="dark"] .btn{color:#0F1A18}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .btn{color:#0F1A18}}
.btn:hover{filter:brightness(1.1)}
.btn:disabled{opacity:.6;cursor:wait}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--line);width:auto}
.btn.small{width:auto;min-height:40px;padding:8px 16px;font-size:.95rem}
.sum .act{padding:14px 18px 18px}
.note{font-size:.85rem;color:var(--muted);margin:10px 0 0}
.banner{background:var(--gold-soft);border-left:5px solid var(--gold);padding:10px 14px;border-radius:8px;margin:0 0 24px;font-size:.95rem}

/* Success */
.done{background:var(--surface);border:2px solid var(--green);border-radius:18px;padding:28px;max-width:640px;margin:0 auto}
.done h2{font-family:var(--display);font-size:1.8rem;margin:0 0 6px}
.code{font-family:var(--display);font-weight:800;font-size:2rem;letter-spacing:.04em;background:var(--green-soft);color:var(--green);border-radius:12px;padding:10px 16px;display:inline-block;margin:10px 0 16px}
.done dl{margin:0 0 18px}
.done dt{font-size:.85rem;color:var(--muted);margin-top:10px}
.done dd{margin:0;font-weight:600}
.row{display:flex;gap:12px;flex-wrap:wrap}

/* Admin */
#admin{display:none}
#admin.on{display:block}
.panel{background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:20px;margin-bottom:24px}
.panel h2{font-family:var(--display);margin:0 0 12px;font-size:1.3rem}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:24px}
.stat{background:var(--green-soft);border-radius:12px;padding:12px 14px}
.stat b{display:block;font-family:var(--display);font-size:1.8rem;line-height:1.1}
.stat span{font-size:.9rem;color:var(--muted)}
.tablewrap{overflow-x:auto;max-width:100%}
table{border-collapse:collapse;width:100%;min-width:760px;font-size:.92rem}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:600;color:var(--muted);white-space:nowrap}
.fees input{min-height:40px;padding:6px 10px;width:130px}
.fees th,.fees td{white-space:nowrap}
.empty-state{padding:20px;color:var(--muted);text-align:center}
.drop{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.pick{display:inline-flex;align-items:center;gap:8px;border:2px dashed var(--green);color:var(--green);border-radius:12px;padding:12px 18px;min-height:48px;cursor:pointer;font-weight:600;background:var(--surface)}
.pick:hover{background:var(--green-soft)}
.pick input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.pick:focus-within{outline:3px solid var(--focus);outline-offset:2px}
.pick.off{opacity:.5;cursor:not-allowed}
.thumbs{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}
.th{position:relative;width:120px;height:120px;border-radius:12px;overflow:hidden;border:2px solid var(--line);background:var(--surface)}
.th img{width:100%;height:100%;object-fit:cover;display:block}
.th button{position:absolute;top:4px;right:4px;width:30px;height:30px;border-radius:50%;border:0;background:rgba(0,0,0,.72);color:#fff;cursor:pointer;font-size:1.05rem;line-height:1}
dialog{border:2px solid var(--line);border-radius:16px;background:var(--surface);color:var(--ink);padding:18px;max-width:min(92vw,720px)}
dialog::backdrop{background:rgba(0,0,0,.55)}
dialog img{max-width:100%;max-height:60vh;display:block;margin:0 auto 12px;border-radius:10px}
[hidden]{display:none!important}
.tools{flex-wrap:wrap;align-items:center;position:relative}
.admintools{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.bellwrap{position:relative}
.bell{position:relative;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.45);background:rgba(255,255,255,.14);color:#fff;cursor:pointer;display:grid;place-items:center}
.bell:hover{background:rgba(255,255,255,.26)}
.bell svg{width:22px;height:22px}
.badge{position:absolute;top:-4px;right:-4px;min-width:20px;height:20px;padding:0 5px;border-radius:999px;background:var(--gold);color:#182623;font-size:.75rem;font-weight:700;display:grid;place-items:center;border:2px solid var(--green)}
.notif{position:absolute;right:0;top:calc(100% + 10px);width:min(380px,calc(100vw - 40px));max-height:70vh;overflow:auto;background:var(--surface);color:var(--ink);border:2px solid var(--line);border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.25);z-index:30;text-align:left}
.notif header{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface)}
.notif header b{font-family:var(--display);font-size:1.05rem}
.linkbtn{background:none;border:0;padding:0;color:var(--green);font-weight:600;cursor:pointer;text-align:left;text-decoration:underline;text-underline-offset:3px}
.nitem{display:block;width:100%;text-align:left;background:none;border:0;border-bottom:1px solid var(--line);padding:12px 14px;cursor:pointer;color:var(--ink)}
.nitem:hover{background:var(--green-soft)}
.nitem .t{display:flex;gap:8px;align-items:center;font-weight:600}
.nitem .m{font-size:.85rem;color:var(--muted);margin-top:2px}
.udot{width:9px;height:9px;border-radius:50%;background:var(--red);flex:none}
.pill{display:inline-block;background:var(--red-soft);color:var(--red);border-radius:999px;padding:1px 8px;font-size:.78rem;font-weight:600}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:12px;z-index:60;max-width:90vw;font-weight:500;box-shadow:0 8px 24px rgba(0,0,0,.3)}
dialog{max-height:88vh;overflow:auto}
dialog h2{font-family:var(--display);margin:0 0 8px;font-size:1.4rem}
dialog dl{margin:0 0 14px}
dialog dt{font-size:.85rem;color:var(--muted);margin-top:10px}
dialog dd{margin:0;font-weight:600;overflow-wrap:anywhere}
.dphotos{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.dphotos img{max-width:100%;width:260px;border-radius:10px;margin:0}
footer{padding:0 0 30px;color:var(--muted);font-size:.88rem;text-align:center}
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <p class="org">Dinas Kebudayaan Provinsi DKI Jakarta</p>
    <h1>Daftar jadi peserta UMKM</h1>
    <div class="route" aria-label="Jadwal dan lokasi">
      <div class="leg"><span class="dot" aria-hidden="true"></span><div><b>12–15 Desember</b><span>Kawasan UPK Kota Tua</span></div></div>
      <div class="leg"><span class="dot" aria-hidden="true"></span><div><b>16–20 Desember</b><span>Pasar Hexagon</span></div></div>
    </div>
    <div class="tools">
      <button class="chipbtn" id="loginBtn" type="button">Login panitia</button>
      <div class="admintools" id="adminTools" hidden>
        <div class="bellwrap">
          <button class="bell" id="bellBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="notif" aria-label="Notifikasi pendaftar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span class="badge" id="badge" hidden>0</span>
          </button>
          <div class="notif" id="notif" hidden role="region" aria-label="Pendaftar terbaru">
            <header><b>Pendaftar terbaru</b><button class="linkbtn" id="markRead" type="button">Tandai sudah dibaca</button></header>
            <div id="notifList"></div>
          </div>
        </div>
        <button class="chipbtn" id="adminBtn" type="button">Buka panel panitia</button>
        <button class="chipbtn" id="logoutBtn" type="button">Keluar</button>
      </div>
    </div>
  </div>
</header>
<div class="tumpal" aria-hidden="true"></div>

<main>
<div class="wrap">

  <!-- Panel panitia -->
  <section id="admin" aria-label="Panel panitia">
    <div class="stats" id="stats"></div>

    <div class="panel">
      <h2>Biaya pendaftaran</h2>
      <p class="hint">Kosongkan kolom yang belum ditetapkan. Calon peserta akan melihat "Menyusul" untuk pilihan tersebut.</p>
      <div class="tablewrap">
        <table class="fees" id="feeTable"></table>
      </div>
      <p style="margin:14px 0 0"><button class="btn small" id="saveFees" type="button">Simpan biaya</button> <span id="feeMsg" class="note" role="status"></span></p>
    </div>

    <div class="panel">
      <div class="row" style="justify-content:space-between;align-items:center;margin-bottom:12px">
        <h2 style="margin:0">Data pendaftar</h2>
        <button class="btn small ghost" id="exportBtn" type="button">Unduh CSV</button>
      </div>
      <div class="tablewrap" id="regTable"></div>
    </div>
  </section>

  <!-- Formulir -->
  <div id="formView">
    <div id="banner" class="banner" hidden></div>
    <div class="grid">
      <form id="form" novalidate onsubmit="return false">

        <fieldset id="fs-cat">
          <legend><span class="n">1</span>Kategori UMKM</legend>
          <p class="hint">Pilih satu yang paling sesuai dengan usaha Anda.</p>
          <div class="opts three" id="catOpts"></div>
          <div class="section-err" id="e-cat">Pilih salah satu kategori.</div>
        </fieldset>

        <fieldset id="fs-prod">
          <legend><span class="n">2</span>Yang dijual</legend>
          <p class="hint">Boleh pilih lebih dari satu.</p>
          <div class="tags" id="prodOpts"></div>
          <div class="other" id="otherWrap" hidden>
            <label class="field" style="margin:0">
              <span>Sebutkan produk lainnya</span>
              <input type="text" id="other" maxlength="120" placeholder="Contoh: tanaman hias, mainan edukasi" autocomplete="off">
            </label>
          </div>
          <div class="section-err" id="e-prod">Pilih minimal satu jenis dagangan.</div>
        </fieldset>

        <fieldset id="fs-pkg">
          <legend><span class="n">3</span>Lama hari dan lokasi</legend>
          <p class="hint">Acara berlangsung 12–20 Desember di dua lokasi.</p>
          <div class="opts three" id="pkgOpts"></div>
          <div class="section-err" id="e-pkg">Pilih salah satu pilihan lama hari.</div>
        </fieldset>

        <fieldset id="fs-data">
          <legend><span class="n">4</span>Data UMKM dan kontak</legend>
          <p class="hint">Panitia akan menghubungi nomor ini untuk konfirmasi.</p>
          <label class="field"><span>Nama UMKM</span>
            <input type="text" id="nama" maxlength="100" autocomplete="organization" placeholder="Contoh: Kerak Telor Bang Dul">
            <p class="err" id="e-nama"></p></label>
          <div class="two">
            <label class="field"><span>Nama kontak person</span>
              <input type="text" id="kontak" maxlength="80" autocomplete="name">
              <p class="err" id="e-kontak"></p></label>
            <label class="field"><span>Nomor WhatsApp</span>
              <input type="tel" id="hp" inputmode="tel" maxlength="20" autocomplete="tel" placeholder="08xxxxxxxxxx">
              <p class="err" id="e-hp"></p></label>
          </div>
          <label class="field"><span>Email <i>(opsional)</i></span>
            <input type="email" id="email" maxlength="100" autocomplete="email">
            <p class="err" id="e-email"></p></label>
          <label class="field"><span>NIB (Nomor Induk Berusaha) <i>(opsional)</i></span>
            <input type="text" id="nib" inputmode="numeric" maxlength="20" placeholder="13 digit angka" autocomplete="off">
            <p class="err" id="e-nib"></p></label>
        </fieldset>

        <fieldset id="fs-photo">
          <legend><span class="n">5</span>Foto produk <span style="font-weight:500;color:var(--muted);font-size:1rem">(opsional)</span></legend>
          <p class="hint">Unggah hingga 2 foto produk atau stan. Ukuran foto dikecilkan otomatis.</p>
          <div class="drop">
            <label class="pick" id="pickLbl"><input type="file" id="photoIn" accept="image/*" multiple><span>Pilih foto</span></label>
            <span class="note" id="photoCount" style="margin:0">Belum ada foto</span>
          </div>
          <p class="err" id="e-photo"></p>
          <div class="thumbs" id="thumbs"></div>
        </fieldset>

        <div id="mobileSubmit"></div>
      </form>

      <aside>
        <div class="sum" id="sum" aria-live="polite">
          <h2>Ringkasan pendaftaran</h2>
          <dl>
            <dt>Kategori</dt><dd id="s-cat" class="empty">Belum dipilih</dd>
            <dt>Yang dijual</dt><dd id="s-prod" class="empty">Belum dipilih</dd>
            <dt>Lama hari</dt><dd id="s-pkg" class="empty">Belum dipilih</dd>
            <dt>UMKM</dt><dd id="s-nama" class="empty">Belum diisi</dd>
            <dt>Kontak person</dt><dd id="s-kontak" class="empty">Belum diisi</dd>
            <dt>NIB</dt><dd id="s-nib" class="empty">Tidak diisi</dd>
            <dt>Foto produk</dt><dd id="s-foto" class="empty">Tidak ada</dd>
